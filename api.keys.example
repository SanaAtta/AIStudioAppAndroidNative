# Use secrets.properties (recommended — not overwritten by Android Studio).
# Copy secrets.properties.example → secrets.properties and fill in your keys.

pollinations.api.key=YOUR_POLLINATIONS_SECRET_KEY   # https://enter.pollinations.ai
